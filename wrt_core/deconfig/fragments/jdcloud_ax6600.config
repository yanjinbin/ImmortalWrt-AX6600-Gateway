# 京东云 AX6600 雅典娜（RE-CS-02）定制包
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo-meta=n
CONFIG_PACKAGE_mihomo-alpha=n
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_kmod-dummy=y

# AX6600 不预装 L2TP/VPN；覆盖通用 NSS 片段中的 L2TP 加速依赖。
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=n
CONFIG_PACKAGE_kmod-l2tp=n
CONFIG_PACKAGE_kmod-pppol2tp=n

# 主题：默认由首启脚本设为 OpenWrt，UniWRT/Footstrap 可切换。
CONFIG_PACKAGE_luci-theme-openwrt=y
CONFIG_PACKAGE_luci-theme-uniwrt=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=n

# 常用基础组件
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-df=y
CONFIG_PACKAGE_collectd-mod-sensors=y

# AX6600 无线固件与 ath11k 驱动
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
