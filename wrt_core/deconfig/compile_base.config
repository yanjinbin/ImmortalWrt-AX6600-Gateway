# Compile
CONFIG_USE_APK=n
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y

# Proto
CONFIG_PACKAGE_proto-bonding=y
CONFIG_PACKAGE_luci-proto-relay=y

# Libraries
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_libopenssl-legacy=y

# Disable Package
CONFIG_PACKAGE_automount=n

#  DEFAULT SET
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

#  Coremark
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=6

#  iptables nft
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# Enable Luci App
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 本项目统一排除的插件。该段位于公共配置末尾，用于覆盖旧设备配置。
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_adguardhome=n
CONFIG_PACKAGE_luci-app-appfilter=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_open-app-filter=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_mosdns=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_lucky=n
CONFIG_PACKAGE_luci-app-cupsd=n
CONFIG_PACKAGE_cups=n
CONFIG_PACKAGE_p910nd=n
CONFIG_PACKAGE_kmod-usb-printer=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_luci-app-pbr=n
CONFIG_PACKAGE_pbr=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_wol=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_samba4=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_luci-app-ksmbd=n
CONFIG_PACKAGE_ksmbd=n
CONFIG_PACKAGE_luci-app-nfs=n
CONFIG_PACKAGE_nfs-utils=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_miniupnpd=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_vlmcsd=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-quickfile=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_dockerman=n
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_wireguard-tools=n
CONFIG_PACKAGE_kmod-wireguard=n
CONFIG_PACKAGE_luci-app-openvpn=n
CONFIG_PACKAGE_openvpn-openssl=n
CONFIG_PACKAGE_xl2tpd=n
CONFIG_PACKAGE_kmod-l2tp=n
CONFIG_PACKAGE_kmod-pppol2tp=n
CONFIG_PACKAGE_strongswan=n
CONFIG_PACKAGE_luci-app-strongswan=n
CONFIG_PACKAGE_ocserv=n
CONFIG_PACKAGE_luci-app-ocserv=n
CONFIG_PACKAGE_luci-app-tailscale=n
CONFIG_PACKAGE_tailscale=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_zerotier=n
CONFIG_PACKAGE_luci-app-easytier=n
CONFIG_PACKAGE_easytier=n
